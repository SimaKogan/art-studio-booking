# Copy to .env (docker compose reads it automatically). Never commit the real file.
DB_PASSWORD=change-me
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
SEED_DEMO_DATA=true

# GenAI schedule assistant: local (offline, default) or vertex (Gemini on Vertex AI)
AI_PROVIDER=local
VERTEX_PROJECT_ID=
VERTEX_LOCATION=us-central1
VERTEX_MODEL=gemini-2.5-flash
